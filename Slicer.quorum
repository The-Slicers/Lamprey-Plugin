// OrcaPlugin, SlicePlugin, SlicerPlugin, ... not sure what to name
package Slice
use Libraries.System.File

class Slicer
	// --------------------------------------------------------------------------
	// ** Private Variables **
	private boolean openSession  = false
	private boolean modelLoaded  = false
	private boolean settingFiles = 0
	private text    errorMessage = ""

	// --------------------------------------------------------------------------
	// ** Public Functions **
	// Opens a slicing session, or returns true if one is open
	action Open returns boolean
		if openSession = true
			return true
		end
		if JavaOpen() = false
			return ErrorMsg("Slicing session failed to open.")
		end

		// New Session Opened, Reset Values
		openSession  = true
		modelLoaded  = false
		settingFiles = 0
		errorMessage = ""

		return true
	end

	// Closes an open session
	action Close
		if openSession = true
			JavaClose()
		end
		
		// Reset Values
		openSession  = false
		modelLoaded  = false
		settingFiles = 0
	end

	// Load 3D model
	action LoadModel (text filePath) returns boolean
		if pathExists(filePath) = false
			return false
		end
		if Open() = false
			return false
		end
		if JavaLoadModel(filePath) = false
			modelLoaded = false
			return ErrorMsg("Model could not load: " + JavaErrorMsg())
		end
		
		// if it makes it here file was loaded
		modelLoaded = true
		errorMessage = ""
		return true
	end

	// Load the settings files (printer, filament, process)
	// Maybe rename since it only takes 1 setting file?
	// JSON files
	action LoadSettings (text filePath) returns boolean
		// check that file exists, if not return false
		// check that session is open, if not return false
		// try opening file with java call, if can't return error/false
		
		// if it makes it here file was loaded
		settingFiles += 1
		errorMessage = ""
		return true
	end

	// function to load all 3 setting files at once instead of separately?

	// functions to change settings maybe?
	// what settings do we want a user to be able to change?

	// Slices the model
	action Slice (text gcodePath) returns boolean
		// if session not open, return error/false
		// if model not loaded, return error/false
		// if settingFiles < 3, return error/false
			 // assuming we require printer, filament, process JSON files?
		// check gcodePath exists, otherwise return error/false
		// try slcing java call, if can't return error/false

		// if here slice succeeded
		errorMessage = ""
		return true
	end

	// --------------------------------------------------------------------------
	// ** PRIVATE HELPER FUNCTIONS **
	// Updates the class's errorMessage & returns false
	private action ErrorMsg (text msg) returns boolean
		errorMessage = msg
		return false
	end

	/*
	Check that file path exists
	Quorum File:
			Quorum/Library/Standard/Libraries/System/File.quorum
			Lines 288 & 308
	*/
	private action pathExists(text filePath) returns boolean
		if path = ""
			return ErrorMsg("No path was given.")
		end
		File fileObj
		fileObj:SetPath(filePath)
		if fileObj:Exists() = false
			return ErrorMsg("File Path: " + filePath + " does not exist.")
		end

		// otherwise file path exists
		return true
	end

	// --------------------------------------------------------------------------
	// ** JAVA CALLS **
	private system action JavaOpen returns boolean
	private system action JavaClose
	private system action JavaLoadModel(text filePath) returns boolean
	private system action JavaLoadSettings(text filePath)	// returns bool? int?
	private system action JavaSlice(text gcodePath) 			// returns bool? int?
	private system action JavaErrorMsg returns text
end //of slicer class