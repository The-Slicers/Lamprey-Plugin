Trying out code in Quorum that does the calling of Java functions
that would then call C++\OrcaSlicer.
For the non-CLI path.
*/

/*
Quorum call to Java	looks like:
	system action actionName (parameters) returns dataType
*/

// ... not sure what to name
package Slice
use Libraries.System.File

class Slicer
	// --------------------------------------------------------------------------
	// ** Private Variables **
	private boolean openSession  = false	// True if open OrcaSlicer session
	private boolean modelLoaded  = false	// True if a model is loaded
	private boolean settingFiles = 0 			// Number of setting files loaded
	private text    errorMessage = ""			// Most recent error message

	// --------------------------------------------------------------------------
	// ** Public Functions **
	// Opens a slicing session, or returns true if one is open
	action Open returns boolean
		if openSession = true
			return true
		end
		if JavaOpen() = false
			return ErrorMsg("Slicing session failed to open.")
		end

		// New Session Opened, Reset Values
		openSession  = true
		modelLoaded  = false
		settingFiles = 0
		errorMessage = ""

		return true
	end

	// ------------------------
	// Closes an open session
	action Close
		if openSession = true
			JavaClose()
		end
		
		// Reset Values
		openSession  = false
		modelLoaded  = false
		settingFiles = 0
	end

	// ------------------------
	// Load 3D model
	action LoadModel (text filePath) returns boolean
		if pathExists(filePath) = false
			return false
		end
		if Open() = false
			return false
		end
		if JavaLoadModel(filePath) = false
			modelLoaded = false
			return ErrorMsg("Model could not load: " + JavaErrorMsg())
		end
		
		// if it makes it here file was loaded
		modelLoaded = true
		errorMessage = ""
		return true
	end

	// ------------------------
	// Load the settings files (printer, filament, process)
	// Maybe rename since it only takes 1 setting file?
	// JSON files
	action LoadSettings (text filePath) returns boolean
		if pathExists(filePath) = false
			return false
		end
		if Open() = false
			return false
		end
		if JavaLoadSettings(filePath) = false
			return ErrorMsg("Could not load settings file: " + JavaErrorMsg())
		end

		// if it makes it here file was loaded
		settingFiles += 1
		errorMessage = ""
		return true
	end

	// ------------------------
	// function to load all 3 setting files at once instead of separately?
	/*
		Load all 3 settings files at once.
		Parameters:
			printerPath		The printer JSON file path.
			filamentPath	The filament JSON file path.
			processPath		The process JSON file path.
		Returns:
			True if all 3 successfully loaded.
	*/
	action LoadJSONsettings(text printerPath, text filamentPath, text processPath) returns boolean
		if LoadSettings(printerPath) = false
			return false
		end
		if LoadSettings(filamentPath) = false
			return false
		end
		if LoadSettings(processPath) = false
			return false
		end

		// All 3 loaded successfully
		return true
	end

	// functions to change settings maybe?
	// what settings do we want a user to be able to change?

	// ------------------------
	// Slices the model
	action Slice (text gcodePath) returns boolean
		// if session not open, return error/false
		// if model not loaded, return error/false
		// if settingFiles < 3, return error/false
			 // assuming we require printer, filament, process JSON files?
		// check gcodePath exists, otherwise return error/false
		// try slcing java call, if can't return error/false

		// if here slice succeeded
		errorMessage = ""
		return true
	end

	// ------------------------
	// Get the most recent error message
	action GetErrorMessage returns text
		return errorMessage
	end

	// ------------------------
	// Check if there's an open OrcasSlicer session
	action IsOpen returns boolean
		return openSession
	end

	// --------------------------------------------------------------------------
	// ** PRIVATE HELPER FUNCTIONS **
	// Updates the class's errorMessage variable & returns false
	private action ErrorMsg (text msg) returns boolean
		errorMessage = msg
		return false
	end

	/* ------------------------
	Check that file path exists
	Quorum File:
			Quorum/Library/Standard/Libraries/System/File.quorum
			Lines 288 & 308
	*/
	private action pathExists(text filePath) returns boolean
		if path = ""
			return ErrorMsg("No path was given.")
		end
		File fileObj
		fileObj:SetPath(filePath)
		if fileObj:Exists() = false
			return ErrorMsg("File Path: " + filePath + " does not exist.")
		end

		// otherwise file path exists
		return true
	end

	// --------------------------------------------------------------------------
	// ** JAVA CALLS **
	private system action JavaOpen returns boolean
	private system action JavaClose
	private system action JavaLoadModel(text filePath) returns boolean
	private system action JavaLoadSettings(text filePath)	// returns bool? int?
	private system action JavaSlice(text gcodePath) 			// returns bool? int?
	private system action JavaErrorMsg returns text
end //of slicer class